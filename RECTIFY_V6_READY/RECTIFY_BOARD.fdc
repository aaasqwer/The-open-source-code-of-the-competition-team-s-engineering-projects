# V3 observational Gray timebase only, per UCE guide section2.2.3.1.
set_max_skew -from [get_pins {performance/gray_tick*/Q*}] -to [get_cells {performance/pix_time_meta*}] 7.500
set_max_skew -from [get_pins {performance/gray_tick*/Q*}] -to [get_cells {fram_buf/capture/capture_time_meta*}] 7.500
