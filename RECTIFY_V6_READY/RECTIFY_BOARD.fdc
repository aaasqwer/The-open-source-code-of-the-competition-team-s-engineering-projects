# ATK-MS901M UART on MES-FMC-LPC-IO J3 pin 23/24 (LA22_N/P; PG2L100H-676 supported)
# J2 is reserved for the Double_OV5640 camera. Connect module TX -> imu_uart_rx (J3 pin 23 / W26),
# module RX <- imu_uart_tx (J3 pin 24 / V26), and use J3 pin 37/38 GND plus pin 39/40 3.3V.
# J3 pins marked * in the hardware manual are NC on PG2L100H-676 and are intentionally unused.
define_attribute {p:imu_uart_rx} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:imu_uart_rx} {PAP_IO_LOC} {W26}
define_attribute {p:imu_uart_rx} {PAP_IO_VCCIO} {2.5}
