# RETURN_PC_1 new asynchronous USB control input and independent Ethernet clock.
set_false_path -from [get_ports uart_rx]
create_clock -name eth_rxc [get_ports rgmii_rxc] -period 8.000
create_generated_clock -name eth_clk -source [get_ports rgmii_rxc] -divide_by 1 [get_pins {u_pc/image_ethernet/io/GTP_CLKBUFG_RXSHFT/CLKOUT}]
set_clock_groups -name ethernet_async -asynchronous -group [get_clocks {eth_rxc eth_clk}]

