define_attribute {p:imu_uart_tx} {PAP_IO_LOC} {V26}
define_attribute {p:imu_uart_tx} {PAP_IO_VCCIO} {2.5}
define_attribute {p:imu_uart_tx} {PAP_IO_STANDARD} {LVCMOS25}
define_attribute {p:imu_uart_tx} {PAP_IO_DRIVE} {4}
define_attribute {p:imu_uart_tx} {PAP_IO_NONE} {TRUE}
define_attribute {p:imu_uart_tx} {PAP_IO_SLEW} {FAST}
set_false_path -from [get_ports {imu_uart_rx}]

